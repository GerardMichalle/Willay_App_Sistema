# ─── Plantilla de variables de entorno ───
# Copia a .env y completa. NUNCA subas .env al repositorio.

# Base de datos
DB_NAME=willay
DB_USER=willay
DB_PASSWORD=              # contraseña larga y aleatoria

# Seguridad — genera con:  openssl rand -base64 48
JWT_SECRET=

# Dominio del frontend autorizado (separar con comas si hay varios)
CORS_ORIGENES=https://app.willay.pe

# Cuenta inicial del proveedor (solo se usa si la base está vacía)
BOOTSTRAP_EMAIL=soporte@willay.pe
BOOTSTRAP_PASSWORD=       # cámbiala tras el primer ingreso

# Documentación de la API en producción (recomendado: false)
SWAGGER_ENABLED=false

# Notificaciones push del navegador (Web Push / VAPID) — opcional.
# Sin estas claves el sistema funciona igual; solo se omite el envío push.
# Genera un par con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@willay.pe

# Notificaciones push nativas de la app Android (Firebase Cloud Messaging)
# — opcional, igual que VAPID arriba. La credencial es el .json de una
# cuenta de servicio (Firebase console → Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada). Es sensible: da
# acceso completo para mandar notificaciones y administrar el proyecto.
#
# Dos formas de dársela al backend (con una alcanza):
#  · FIREBASE_CREDENTIALS_PATH  (recomendada en el servidor) — ruta a ese
#    .json guardado en el disco del servidor, FUERA de este repo. Ver el
#    volumen comentado en docker-compose.prod.yml para montarlo dentro
#    del contenedor. El archivo nunca pasa por una variable de entorno.
#  · FIREBASE_CREDENTIALS_JSON  (más simple, ej. para desarrollo local) —
#    el contenido completo del .json pegado en una sola línea. Cuidado:
#    nunca debe terminar commiteado ni pegado en un lugar donde otros lo
#    vean — es tan sensible como una contraseña de administrador.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Correo transaccional (Resend) — opcional en desarrollo.
RESEND_API_KEY=
RESEND_FROM=Willay <onboarding@resend.dev>
